{
  "name": "hulum",
  "private": true,
  "version": "0.1.0",
  "description": "HULUM — AI opportunity decision and readiness agent",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev -w @hulum/web\" \"npm run dev -w @hulum/server\"",
    "dev:web": "npm run dev -w @hulum/web",
    "dev:server": "npm run dev -w @hulum/server",
    "build": "npm run build -w @hulum/web",
    "build:server": "npm run build -w @hulum/server",
    "typecheck:shared": "npm run typecheck -w @hulum/shared",
    "typecheck:server": "npm run typecheck -w @hulum/server",
    "lint": "eslint apps/server/src apps/web/src packages/shared/src",
    "format": "prettier --write \"apps/server/src/**/*.{ts,tsx}\" \"apps/web/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\" eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check \"apps/server/src/**/*.{ts,tsx}\" \"apps/web/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\" eslint.config.mjs .prettierrc.json",
    "test": "npm run test -w @hulum/server",
    "test:server": "npm run test -w @hulum/server",
    "test:failures": "npm exec -w @hulum/server -- vitest run src/shared-failure-messages.test.ts src/http/error-handler.test.ts",
    "db:migrate": "npm run db:migrate -w @hulum/server",
    "db:seed": "npm run db:seed -w @hulum/server",
    "db:smoke": "npm run db:smoke -w @hulum/server",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
