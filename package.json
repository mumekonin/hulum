{
  "name": "hulum",
  "private": true,
  "version": "0.1.0",
  "description": "HULUM — AI opportunity decision and readiness agent",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev -w @hulum/web\" \"npm run dev -w @hulum/server\"",
    "dev:web": "npm run dev -w @hulum/web",
    "dev:server": "npm run dev -w @hulum/server",
    "test": "npm run test -w @hulum/server",
    "build": "npm run build -w @hulum/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23"
  }
}
