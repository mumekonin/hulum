# Server
NODE_ENV=
PORT=
# Web app origin for CORS, e.g. http://localhost:3000 — not the API port
CLIENT_URL=
STORE_PATH=

# Optional — leftover name. v0.1 explain uses Groq, not Claude.
CLAUDE_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional — Groq wording on POST /api/analyses/:id/explain (never decides APPLY/MAYBE/SKIP).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional — leftover naming. Voxide widget uses a public key on the web origin.
VOXIDE_API_KEY=

# Required for npm run dev (Postgres path). Never commit real values.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web → API (default in code: http://localhost:3001)
NEXT_PUBLIC_API_URL=

# Optional — ScholarXIV Papers API for /research. Server only. Never commit the value.
SCHOLARXIV_API_KEY=

# Optional — Voxide publishable widget key (vox_pub_…). Web origin only (http://localhost:3000).
# Whitelist that origin in the Voxide dashboard. Do not put a secret Voxide key on the API.
# Never commit the real value.
NEXT_PUBLIC_VOXIDE_KEY=
