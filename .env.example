# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
STORE_PATH=./data/store.json

# Optional — explanation layer. The decision engine works without this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_API_KEY=

# Optional — Voxide voice. Text/quick actions work without this.
VOXIDE_API_KEY=

# Optional — Supabase (file store is used until these are set)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
