# Server
NODE_ENV=
PORT=
# Web app origin for CORS, e.g. http://localhost:3000 — not the API port
CLIENT_URL=
STORE_PATH=

# Optional — leftover name. v0.1 explain uses Groq, not Claude.
CLAUDE_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional — Groq wording on POST /api/analyses/:id/explain (never decides APPLY/MAYBE/SKIP).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=

# Optional — leftover naming. Browser Voxide uses NEXT_PUBLIC_VOXIDE_PUBLIC_KEY on the web origin.
VOXIDE_API_KEY=

# Optional — Voxide publishable key (vox_pub_…). Domain-whitelist localhost:3000 in the Voxide dashboard.
NEXT_PUBLIC_VOXIDE_PUBLIC_KEY=

# Required for npm run dev (Postgres path). Never commit real values.
DATABASE_URL=
# Optional ms to wait for a Postgres connection (default 5000); raise for a slow remote database
DATABASE_CONNECT_TIMEOUT_MS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web → API (default in code: http://localhost:3001)
NEXT_PUBLIC_API_URL=

# Optional — ScholarXIV Papers API for /research. Server only. Never commit the value.
SCHOLARXIV_API_KEY=
# Optional — background investigator (server). Same extract rules as POST /api/investigate.
# Default on when GROQ_API_KEY + GROQ_MODEL are set. Never invents listings.
INVESTIGATE_WORKER=
INVESTIGATE_INTERVAL_HOURS=
INVESTIGATE_ON_START=
# JWT for X-Hulum-Session. Required in production. Empty uses a local-only signing default (not for production).
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset email (server only). Reset links use CLIENT_URL + /reset-password.
# Until SMTP_HOST and MAIL_FROM are set, /forgot-password says email is unavailable (nothing is faked).
SMTP_HOST=
SMTP_PORT=
# true for implicit TLS (usually port 465); otherwise STARTTLS when the server offers it (usually 587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# e.g. HULUM <no-reply@your-domain>
MAIL_FROM=

# Optional — Voxide publishable widget key (vox_pub_…). Web origin only (http://localhost:3000).
# Whitelist that origin in the Voxide dashboard. Do not put a secret Voxide key on the API.
# Never commit the real value.
NEXT_PUBLIC_VOXIDE_KEY=
