# Server
NODE_ENV=
PORT=
# Web app origin for CORS, e.g. http://localhost:3000 — not the API port
CLIENT_URL=
STORE_PATH=

# Optional — leftover name. v0.1 explain uses Groq, not Claude.
CLAUDE_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional — Groq wording on POST /api/analyses/:id/explain (never decides APPLY/MAYBE/SKIP).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional — leftover naming. Browser Voxide uses NEXT_PUBLIC_VOXIDE_PUBLIC_KEY on the web origin.
VOXIDE_API_KEY=

# Optional — Voxide publishable key (vox_pub_…). Domain-whitelist localhost:3000 in the Voxide dashboard.
NEXT_PUBLIC_VOXIDE_PUBLIC_KEY=

# Required for npm run dev (Postgres path). Never commit real values.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web → API (default in code: http://localhost:3001)
NEXT_PUBLIC_API_URL=
