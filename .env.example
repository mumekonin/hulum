# Server
NODE_ENV=
PORT=
# Web app origin for CORS, e.g. http://localhost:3000 — not the API port
CLIENT_URL=
STORE_PATH=

# Optional — file-store Claude wording. The decision engine works without this.
CLAUDE_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional — Groq wording on the Postgres analysis explain route.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional — Voxide voice. Text/quick actions work without this.
VOXIDE_API_KEY=

# Optional — Postgres (file store is the npm run dev default)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web
NEXT_PUBLIC_API_URL=
