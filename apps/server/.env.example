NODE_ENV=
PORT=
# Web app origin for CORS, e.g. http://localhost:3000 — not the API port
CLIENT_URL=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Screenshot reader (vision). Optional. Default: qwen/qwen3.8-27b
GROQ_VISION_MODEL=
VOXIDE_API_KEY=
# Task 48 — names only. Real values stay in local .env. Never commit them.
# Add a new lead/API later: insert into sources + optional env names below.
JOB_OPPORTUNITIES_API_KEY=
JOB_OPPORTUNITIES_API_URL=
INVESTIGATE_ADMIN_SECRET=
# Background catalog refresh (same rules as POST /api/investigate). No invented listings.
# Default on when GROQ_API_KEY + GROQ_MODEL are set. Set false to disable.
INVESTIGATE_WORKER=
# Hours between runs (default 0.5 / 30 minutes). Or set INVESTIGATE_INTERVAL_MS.
INVESTIGATE_INTERVAL_HOURS=
INVESTIGATE_INTERVAL_MS=
# First run immediately. Set INVESTIGATE_ON_START=false under rapid tsx watch.
# Afriwork Explore jobs needs Playwright Chromium: npx playwright install chromium
INVESTIGATE_ON_START=
INVESTIGATE_START_DELAY_MS=
# AI_EXTRACTED rows not seen again after this many ms become NEEDS_REVIEW (default 3 days).
INVESTIGATE_STALE_AFTER_MS=
# Task 40 — ScholarXIV Papers API. Key stays on the server. Never commit it.
# Create at https://scholarxiv.com/developers
SCHOLARXIV_API_KEY=
# JWT for X-Hulum-Session (profile/analyze/voice). Required in production.
# Leave empty for open local demo (UUID only). Never commit a real value.
SESSION_SECRET=
# Google OAuth (Web client). Redirect: http://localhost:3001/api/auth/google/callback
# Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
